-- 1. Monthly Revenue
SELECT
    dd.year,
    dd.month_name AS month,
    SUM(fs.total_revenue) AS monthly_revenue
FROM fact_sales fs
JOIN dim_date dd ON fs.date_key = dd.date_key
GROUP BY dd.year, dd.month_name
ORDER BY dd.year, dd.month;
 
-- 2. Top Products
SELECT
    dp.product_name,
    dp.category,
    SUM(fs.total_revenue) AS total_revenue,
    SUM(fs.quantity_sold) AS total_quantity_sold
FROM fact_sales fs
JOIN dim_product dp ON fs.product_key = dp.product_key
GROUP BY dp.product_name, dp.category
ORDER BY total_revenue DESC
LIMIT 10;
 
-- 3. Revenue by Region
SELECT
    dr.region_name,
    dr.country,
    SUM(fs.total_revenue) AS regional_revenue
FROM fact_sales fs
JOIN dim_region dr ON fs.region_key = dr.region_key
GROUP BY dr.region_name, dr.country
ORDER BY regional_revenue DESC;
 
-- 4. Repeat Customers
SELECT
    dc.customer_id,
    dc.customer_name,
    COUNT(DISTINCT fs.transaction_id) AS total_transactions
FROM fact_sales fs
JOIN dim_customer dc ON fs.customer_key = dc.customer_key
GROUP BY dc.customer_id, dc.customer_name
HAVING COUNT(DISTINCT fs.transaction_id) > 1
ORDER BY total_transactions DESC;
